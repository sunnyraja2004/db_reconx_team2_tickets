<?xml version="1.0" encoding="UTF-8"?>

<!--
 ============================================================================
 TICKET-ADV012 / ADV013 / ADV014 — first changeset + rollback + preconditions

 WHAT:    Initial DB setup tag.

 ADV014:
          Adds precondition to ensure the tag changeset is not executed again
          if it already exists.

 WHY:     Prevents failures when changelog is re-applied on an existing DB.

 OBSERVE: Liquibase second execution completes without errors.
 ============================================================================
-->

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">


    <changeSet id="001-init-tag" author="trainer">

        <preConditions onFail="MARK_RAN">
            <not>
                <changeSetExecuted
                        id="001-init-tag"
                        author="trainer"/>
            </not>
        </preConditions>


        <tagDatabase tag="v1.0.0-init"/>


    </changeSet>


</databaseChangeLog>