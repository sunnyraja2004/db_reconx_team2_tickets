<?xml version="1.0" encoding="UTF-8"?>

<!--
 ============================================================================
 TICKET-ADV017 + TICKET-ADV014 — Seed data with preconditions
 WHAT:    Loads CSV files and demo users safely.
 HOW:     Seed changesets run only for dev/test environments and check that
          target tables are empty before inserting data.
 WHY:     Prevents duplicate seed data when changelog is executed multiple
          times.
 OBSERVE: Running Liquibase twice skips existing seed data instead of
          inserting duplicates.
 ============================================================================
-->

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">


    <changeSet id="008-seed-counterparties" author="trainer" context="dev,test">

        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM counterparties;
            </sqlCheck>
        </preConditions>

        <loadData file="data/counterparties.csv"
                  tableName="counterparties"
                  separator=","
                  relativeToChangelogFile="true">

            <column name="id" type="NUMERIC"/>
            <column name="name" type="STRING"/>
            <column name="lei_code" type="STRING"/>
            <column name="region" type="STRING"/>

        </loadData>

        <rollback>
            <sql>DELETE FROM counterparties;</sql>
        </rollback>

    </changeSet>


    <changeSet id="008-seed-instruments" author="trainer" context="dev,test">

        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM instruments;
            </sqlCheck>
        </preConditions>

        <loadData file="data/instruments.csv"
                  tableName="instruments"
                  separator=","
                  relativeToChangelogFile="true">

            <column name="id" type="NUMERIC"/>
            <column name="symbol" type="STRING"/>
            <column name="name" type="STRING"/>
            <column name="asset_class" type="STRING"/>
            <column name="currency" type="STRING"/>
            <column name="isin" type="STRING"/>

        </loadData>

        <rollback>
            <sql>DELETE FROM instruments;</sql>
        </rollback>

    </changeSet>


    <changeSet id="008-seed-users" author="trainer" context="dev,test">

        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM users;
            </sqlCheck>
        </preConditions>

        <!--
            Real BCrypt hashes (cost=10) for:
            admin123 / trader123 / viewer123 / recon123
        -->

        <insert tableName="users">
            <column name="email" value="admin@db.com"/>
            <column name="password_hash" value="$2y$10$L9iP3BfsBS2LbVJRfc86TuWnJvP.AohjX3PNLwdtjlZfyB7YSp87C"/>
            <column name="role" value="ADMIN"/>
        </insert>

        <insert tableName="users">
            <column name="email" value="trader@db.com"/>
            <column name="password_hash" value="$2y$10$LIpkayi0QDWyVguPtEQbkOATM7PTnMKFDNq47K92TUx2LHTBFQf1i"/>
            <column name="role" value="TRADER"/>
        </insert>

        <insert tableName="users">
            <column name="email" value="viewer@db.com"/>
            <column name="password_hash" value="$2y$10$gC8J5Tzr15p4V6BgbbEFGOEb4VWM4YUOAdKEeyFlXtEvYolYblCVC"/>
            <column name="role" value="VIEWER"/>
        </insert>

        <insert tableName="users">
            <column name="email" value="recon@db.com"/>
