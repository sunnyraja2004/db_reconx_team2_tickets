<?xml version="1.0" encoding="UTF-8"?>

<!--
 ============================================================================
 TICKET-ADV007 + TICKET-ADV014 — Monthly partitioning of trades on Postgres

 WHAT:    Convert trades into a range-partitioned parent on trade_date and
          create partitions for the current rolling 12 months.

 HOW:     Postgres-only via raw SQL.

 WHY:     PostgreSQL partitioning improves query performance for large trade
          tables.

 ADV014:
          This changeset is protected with a PostgreSQL database precondition.
          Non-Postgres environments skip safely and record the changeset as
          MARK_RAN.

 OBSERVE: Running Liquibase multiple times does not fail.
 ============================================================================
-->

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
        Demonstration only:
        The partitioning conversion is destructive and taught separately.
        Starter version ships a no-op so dev/uat boot cleanly.
    -->

    <changeSet id="004-partition-current-month" author="trainer">

        <preConditions onFail="MARK_RAN">
            <dbms type="postgresql"/>
        </preConditions>

        <comment>
            Placeholder: students rebuild this in ADV007.
            Trainer copy ships a no-op so dev/uat boot cleanly.
        </comment>

        <sql>
            SELECT 1;
        </sql>

        <rollback>
            <sql>
                SELECT 1;
            </sql>
        </rollback>

    </changeSet>

</databaseChangeLog>